      "t4_1",
      "t4_2",
      "t4_3",
      "t5_1",
      "t5_2"
    ],
    "edges": [
      {"from": "t0_1", "to": "t0_5_1"},
      {"from": "t0_5_1", "to": "t1_1"},
      {"from": "t0_5_1", "to": "t1_2"},
      {"from": "t1_1", "to": "t2_1"},
      {"from": "t1_1", "to": "t2_2"},
      {"from": "t1_1", "to": "t2_3"},
      {"from": "t1_1", "to": "t2_4"},
      {"from": "t1_2", "to": "t2_1"},
      {"from": "t1_2", "to": "t2_2"},
      {"from": "t2_1", "to": "t3_1"},
      {"from": "t2_1", "to": "t3_3"},
      {"from": "t2_2", "to": "t3_1"},
      {"from": "t2_2", "to": "t3_2"},
      {"from": "t2_3", "to": "t3_3"},
      {"from": "t2_4", "to": "t3_2"},
      {"from": "t2_4", "to": "t3_3"},
      {"from": "t2_4", "to": "t4_3"},
      {"from": "t3_2", "to": "t4_1"},
      {"from": "t3_3", "to": "t4_1"},
      {"from": "t4_1", "to": "t4_2"},
      {"from": "t4_2", "to": "t5_1"},
      {"from": "t4_3", "to": "t5_1"},
      {"from": "t5_1", "to": "t5_2"}
    ],
    "critical_path": [
      "t0_1",
      "t0_5_1",
      "t1_1",
      "t2_2",
      "t3_2",
      "t4_1",
      "t4_2",
      "t5_1"
    ],
    "parallel_groups": [
      {
        "phase": "phase_0_bootstrap",
        "parallel_tasks": ["t0_1", "t0_2"]
      },
      {
        "phase": "phase_1_specification",
        "parallel_tasks": ["t1_1", "t1_2"]
      },
      {
        "phase": "phase_2_foundation_build",
        "parallel_tasks": ["t2_1", "t2_2", "t2_3", "t2_4"]
      },
      {
        "phase": "phase_3_preflight_validation",
        "parallel_tasks": ["t3_1", "t3_2", "t3_3"]
      },
      {
        "phase": "phase_5_convergence",
        "sequential_tasks": ["t5_1", "t5_2"]
      }
    ]
  },
  "scheduling_strategy": {
    "description": "任务调度策略",
    "rules": [
      "按 phases 顺序推进，phase 内优先并行执行无依赖任务",
      "任务完成后，检查其 required_artifacts 是否已落到 .claude/artifacts/",
      "如果 phase 配置了 gate_on_complete，必须校验 gate 所需产物齐全才可进入下一 phase",
      "任务失败时调用 debug-agent，按 failure_policy 生成最小回滚与回退建议",
      "仅做 phase_local 回滚，不全链路回滚"
    ],
    "resource_constraints": {
      "cpu": {
        "max_concurrent": 10,
        "description": "最多同时运行 10 个 CPU 绑定任务"
      },
      "gpu": {
        "max_concurrent": 2,
        "memory_threshold": 0.90,
        "description": "最多同时运行 2 个 GPU 绑定任务，GPU 内存使用率不超过 90%"
      }
    }
  },
  "failure_handling": {
    "on_task_failed": {
      "max_retries": 2,
      "route_to": "debug_agent",
      "classify_by": ["data", "model", "training", "deployment", "safety"]
    },
    "rollback": {
      "strategy": "phase_local",
      "description": "仅回滚失败phase及其下游，不重置全链路"
    },
    "resume": {
      "allowed": true,
      "from_artifacts": true,
      "description": "支持从已有 artifacts 恢复执行"
    }
  },
  "contracts": {
    "task_output_schema": {
      "type": "object",
      "required": ["status", "summary", "artifacts", "metrics", "next_actions"],
      "properties": {
        "status": {
          "enum": ["success", "failed", "partial"],
          "description": "任务执行状态"
        },
        "summary": {
          "type": "string",
          "description": "任务执行摘要"
        },
        "artifacts": {
          "type": "array",
          "description": "任务生成的产物路径列表"
        },
        "metrics": {
          "type": "object",
          "description": "任务执行相关指标"
        },
        "next_actions": {
          "type": "array",
          "description": "后续行动建议"
        }
      }
    },
    "artifact_validation": {
      "rules": [
        "所有 required_artifacts 必须在任务完成时存在",
        "artifact 路径必须相对于项目根目录",
        "artifact 文件必须符合对应的 JSON Schema",
        "未生成 required artifact 将阻止任务完成"
      ]
    }
  },
  "hooks": {
    "teammate_idle": {
      "enabled": true,
      "rule": "若任务未满足产物契约，返回反馈并要求继续"
    },
    "task_completed": {
      "enabled": true,
      "rule": "若未生成 required artifact 则阻止完成"
    }
  },
  "commands": {
    "train_jax": "uv run python scripts/train.py --config-name=pi05_droid",
    "train_torch": "uv run python scripts/train_pytorch.py --config-name=pi05_droid",
    "serve": "uv run python scripts/serve_policy.py --port=8000",
    "test_models": "pytest --strict-markers src/openpi/models/ -m 'not manual'",
    "test_transforms": "pytest --strict-markers src/openpi/transforms_test.py -m 'not manual'"
  },
  "environment": {
    "cache_variables": [
      "HF_LEROBOT_HOME=/root/autodl-tmp/huggingface",
      "HF_HOME=/root/autodl-tmp/.cache",
      "OPENPI_DATA_HOME=/root/autodl-tmp/openpi_cache"
    ],
    "required_before_execution": [
      "设置环境变量以避免缓存填充主目录",
      "验证 GPU 可用性（用于 GPU 绑定任务）",
      "验证数据路径存在（在 phase_0_5_user_config 后）"
    ]
  }
}
