    {
      "id": "phase_0_5_user_config",
      "tasks": [
        {
          "id": "t0_5_1",
          "agent": "orchestrator",
          "status": "pending",
          "needs": [],
          "produces": [
            ".claude/artifacts/config/data_paths.json"
          ],
          "interactive_prompts": [
            {
              "prompt": "请指定原始数据集的输入路径（包含 parquet 文件的目录）",
              "field": "raw_dataset_path",
              "example": "/path/to/lerobot/dataset/raw",
              "required": true
            },
            {
              "prompt": "请指定处理后数据的输出路径（transform pipeline 产物存放位置）",
              "field": "processed_dataset_path",
              "example": "/path/to/processed/dataset",
              "required": true
            },
            {
              "prompt": "请指定归一化统计结果的输出路径（norm_stats.json 存放位置）",
              "field": "norm_stats_path",
              "example": "/path/to/norm_stats",
              "required": true
            },
            {
              "prompt": "请指定训练 checkpoint 的输出路径（可选，默认使用 artifacts 目录）",
              "field": "checkpoint_path",
              "example": "/path/to/checkpoints",
              "required": false
            },
            {
              "prompt": "请指定评估结果的输出路径（可选，默认使用 artifacts 目录）",
              "field": "evaluation_output_path",
              "example": "/path/to/eval_results",
              "required": false
            }
          ]
        }
      ],
      "gate": "gate_0_5_config_ready"
    },
