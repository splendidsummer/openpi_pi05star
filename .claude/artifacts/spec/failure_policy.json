  "retry_strategy": {
    "max_retries": 2,
    "retry_conditions": [
      {
        "category": "data",
        "retryable_errors": [
          "ConnectionError",
          "TimeoutError",
          "HTTPError",
          "PermissionError",
          "DiskFull"
        ]
      },
      {
        "category": "model",
        "retryable_errors": [
          "FileNotFoundError",
          "ChecksumError",
          "DownloadError"
        ]
      },
      {
        "category": "training",
        "retryable_errors": [
          "RuntimeError",
          "CUDARuntimeError",
          "NCCLError"
        ]
      },
      {
        "category": "deployment",
        "retryable_errors": [
          "PortInUseError",
          "DependencyError",
          "ServiceUnavailable"
        ]
      },
      {
        "category": "safety",
        "retryable_errors": []
      }
    ],
    "backoff_strategy": {
      "initial_delay_seconds": 30,
      "multiplier": 2.0,
      "max_delay_seconds": 300
    },
    "non_retryable_errors": [
      "ValueError",
      "TypeError",
      "AssertionError",
      "ConfigurationError"
    ]
  },
  "rollback_strategy": {
    "strategy": "phase_local",
    "description": "仅回滚失败phase及其下游，不重置全链路",
    "rules": {
      "phase_0_bootstrap": {
        "rollback_scope": ["phase_0_bootstrap"],
        "preserve_artifacts": [],
        "cleanup_intermediate": false
      },
      "phase_0_5_user_config": {
        "rollback_scope": ["phase_0_5_user_config"],
        "preserve_artifacts": [],
        "cleanup_intermediate": false
      },
      "phase_1_specification": {
        "rollback_scope": ["phase_1_specification", "phase_2_foundation_build", "phase_3_preflight_validation", "phase_4_execution_branches", "phase_5_convergence"],
        "preserve_artifacts": ["config/data_paths.json"],
        "cleanup_intermediate": true
      },
      "phase_2_foundation_build": {
        "rollback_scope": ["phase_2_foundation_build", "phase_3_preflight_validation", "phase_4_execution_branches", "phase_5_convergence"],
        "preserve_artifacts": ["config/data_paths.json", "spec/model_config.json", "spec/data_report.json"],
        "cleanup_intermediate": true
      },
      "phase_3_preflight_validation": {
        "rollback_scope": ["phase_3_preflight_validation", "phase_4_execution_branches", "phase_5_convergence"],
        "preserve_artifacts": ["config/data_paths.json", "spec/model_config.json", "spec/data_report.json", "build/transform_pipeline.json", "build/norm_stats.json", "build/train_plan.json", "build/infer_plan.json"],
        "cleanup_intermediate": false
      },
      "phase_4_execution_branches": {
        "rollback_scope": ["phase_4_execution_branches", "phase_5_convergence"],
        "preserve_artifacts": [
          "config/data_paths.json",
          "spec/model_config.json",
          "spec/data_report.json",
          "build/transform_pipeline.json",
          "build/norm_stats.json",
          "build/train_plan.json",
          "build/infer_plan.json",
          "build/module_validation_report.json",
          "build/safety_config.json",
          "build/integration_report.json"
        ],
        "cleanup_intermediate": false,
        "branch_specific": {
          "training_branch": {
            "preserve_artifacts": ["run/checkpoints/latest.ckpt"],
            "checkpoint_retention": "keep_all"
          },
          "evaluation_branch": {
            "preserve_artifacts": ["run/evaluation/latest_metrics.json"]
          },
          "serving_branch": {
            "preserve_artifacts": ["run/deploy/latest_status.json"]
          }
        }
      },
      "phase_5_convergence": {
        "rollback_scope": ["phase_5_convergence"],
        "preserve_artifacts": [
          "config/data_paths.json",
          "spec/model_config.json",
          "spec/data_report.json",
          "build/transform_pipeline.json",
          "build/norm_stats.json",
          "build/train_plan.json",
          "build/infer_plan.json",
          "build/module_validation_report.json",
          "build/safety_config.json",
          "build/integration_report.json",
          "run/checkpoints/latest.ckpt",
          "run/evaluation/latest_metrics.json",
          "run/deploy/latest_status.json"
        ],
        "cleanup_intermediate": false
      }
    },
    "checkpoint_management": {
      "retain_checkpoints": 3,
      "cleanup_old_checkpoints": true,
      "checkpoint_storage_path": ".claude/artifacts/run/checkpoints/"
    }
  },
  "root_cause_analysis": {
    "workflow": [
      {
        "step": 1,
        "name": "Failure Capture",
        "description": "捕获失败事件的上下文信息",
        "collect": [
          "task_id",
          "phase_id",
          "agent_id",
          "error_type",
          "error_message",
          "stack_trace",
          "timestamp",
          "environment_info"
        ]
      },
      {
        "step": 2,
        "name": "Category Classification",
        "description": "根据错误特征分类失败类型",
        "classifier": {
          "data": "检查数据加载、处理、归一化相关堆栈",
          "model": "检查模型架构、权重加载相关堆栈",
          "training": "检查训练循环、优化器、损失函数相关堆栈",
          "deployment": "检查推理服务、API、延迟相关堆栈",
          "safety": "检查安全规则、边界检查相关堆栈"
        }
      },
      {
        "step": 3,
        "name": "Retry Eligibility Check",
        "description": "判断失败是否可重试",
        "conditions": [
          "错误类型在可重试列表中",
          "已重试次数 < max_retries",
          "资源状态正常（磁盘、GPU、网络）"
        ]
      },
      {
        "step": 4,
        "name": "Root Cause Identification",
        "description": "确定根本原因",
        "analysis_methods": [
          "堆栈跟踪分析",
          "日志模式识别",
          "资源使用统计",
          "配置差异对比",
          "历史失败记录查询"
        ]
      },
      {
        "step": 5,
        "name": "Recovery Planning",
        "description": "制定恢复计划",
        "outputs": [
          "recovery_actions": "具体的恢复操作",
          "rerun_scope": "需要重跑的任务范围",
          "rollback_plan": "是否需要回滚及回滚范围",
          "fix_owner": "负责修复的agent",
          "preventive_measures": "预防措施"
        ]
      },
      {
        "step": 6,
        "name": "Execution",
        "description": "执行恢复计划",
        "actions": [
          "执行重试（如果适用）",
          "执行回滚（如果需要）",
          "触发修复任务",
          "更新失败记录"
        ]
      }
    ],
    "templates": {
      "data_loading_failure": {
        "hypothesis": "数据加载可能由于网络问题、缓存损坏或格式错误",
        "verification_steps": [
          "检查HuggingFace缓存完整性",
          "验证parquet文件格式",
          "测试网络连接",
          "检查磁盘空间和权限"
        ],
        "common_solutions": [
          "清理并重建HuggingFace缓存",
          "重新下载数据集",
          "修复数据文件格式",
          "调整数据加载配置"
        ]
      },
      "model_compilation_failure": {
        "hypothesis": "模型编译可能由于配置不匹配或版本兼容性问题",
        "verification_steps": [
          "验证模型配置参数",
          "检查JAX版本兼容性",
          "验证所有张量形状",
          "检查依赖包版本"
        ],
        "common_solutions": [
          "调整模型配置",
          "更新JAX或依赖包",
          "重新编译模型",
          "修复形状不匹配问题"
        ]
      },
      "training_oom_failure": {
        "hypothesis": "训练OOM可能由于batch size过大或内存泄漏",
        "verification_steps": [
          "检查GPU内存使用峰值",
          "分析内存分配模式",
          "检查是否有内存泄漏",
          "验证gradient checkpointing配置"
        ],
        "common_solutions": [
          "降低batch_size",
          "启用gradient checkpointing",
          "使用混合精度训练",
          "清理未使用的变量"
        ]
      },
      "safety_validation_failure": {
        "hypothesis": "安全验证失败可能由于配置错误或算法bug",
        "verification_steps": [
          "验证安全规则配置",
          "检查运动学模型",
          "分析违规日志",
          "测试碰撞检测算法"
        ],
        "common_solutions": [
          "调整安全阈值",
          "修复算法bug",
          "更新运动学模型",
          "优化碰撞检测"
        ]
      }
    }
  },
  "notification_rules": {
    "severity_mapping": {
      "critical": {
        "categories": ["model", "training", "safety"],
        "notify_immediately": true,
        "escalation_minutes": 30
      },
      "high": {
        "categories": ["data", "deployment"],
        "notify_immediately": true,
        "escalation_minutes": 60
      }
    },
    "escalation_rules": [
      {
        "condition": "同一任务失败超过max_retries",
        "action": "escalate_to_orchestrator"
      },
      {
        "condition": "同一phase内失败任务超过50%",
        "action": "pause_phase_and_investigate"
      },
      {
        "condition": "安全类失败",
        "action": "immediate_pause_all_operations"
      }
    ]
  },
  "artifact_preservation": {
    "always_preserve": [
      "config/data_paths.json",
      "spec/model_config.json",
      "run/checkpoints/latest.ckpt"
    ],
    "preserve_on_failure": [
      "build/norm_stats.json",
      "build/transform_pipeline.json",
      "build/module_validation_report.json",
      "build/safety_config.json"
    ],
    "cleanup_after_success": [
      "run/temp/*",
      "logs/*.tmp"
    ]
  }
}
